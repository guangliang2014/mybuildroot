#!/bin/sh

BINARIES_DIR="${0%/*}/"
# shellcheck disable=SC2164
cd "${BINARIES_DIR}"

mode_serial=false
mode_sys_qemu=false
kernel_gdb=false
while [ "$1" ]; do
    case "$1" in
    --serial-only|serial-only) mode_serial=true; shift;;
    --use-system-qemu) mode_sys_qemu=true; shift;;
    -kernel_gdb) kernel_gdb=true; shift;;
    -qemu_gdb) qemu_gdb=true; shift;;
    --) shift; break;;
    *) echo "unknown option: $1" >&2; exit 1;;
    esac
done

if ${mode_serial}; then
    EXTRA_ARGS='@SERIAL_ARGS@'
else
    EXTRA_ARGS='@DEFAULT_ARGS@'
fi

if ! ${mode_sys_qemu}; then
    export PATH="@HOST_DIR@/bin:${PATH}"
fi

# Add EDU PCI device (myedu) to the guest. Set USE_MYEDU=false to disable.
USE_MYEDU=${USE_MYEDU:-true}
EDU_DEV_ARG=""
if [ "${USE_MYEDU}" = "true" ]; then
    EDU_DEV_ARG='-device myedu'
fi


# PCIe topology: 3 root ports (rp1,rp2,rp3)
# - rp1: has an NVMe endpoint
# - rp2: has a downstream pci-bridge (switch)
# - rp3: empty
# NVME image placeholder: set NVME_IMG env or replace @NVME_IMG@ in build.
NVME_IMG=${NVME_IMG:-nvme.img}

# Ensure NVMe image file exists (create empty file if missing)
if [ ! -e "${NVME_IMG}" ]; then
        touch "${NVME_IMG}"
        fallocate -l 1G "${NVME_IMG}"
fi

PCIE_TOPO_ARGS="-device pcie-root-port,id=rp1,bus=pcie.0,chassis=1 \
    -drive file=${NVME_IMG},if=none,id=d0 \
    -device nvme,drive=d0,serial=nvme-1,bus=rp1 \
    -device pcie-root-port,id=rp2,bus=pcie.0,chassis=2 \
    -device x3130-upstream,id=up0,bus=rp2 \
    -device xio3130-downstream,id=dn0,bus=up0,chassis=4 \
    -device pcie-root-port,id=rp3,bus=pcie.0,chassis=3"


# IOMMU support for platform (add an intel-iommu device)
# Set USE_IOMMU=false to disable
USE_IOMMU=${USE_IOMMU:-true}
IOMMU_ARGS=""
if [ "${USE_IOMMU}" = "true" ]; then
    IOMMU_ARGS='-device intel-iommu,intremap=on'
fi


# QEMU tracing/logging options for host (vfio/pci). Set USE_QEMU_TRACE=true to enable
# Example args added: -d trace:*vfio*,trace:*pci*  -D qemu_test-%d.log  -msg timestamp=on
USE_QEMU_TRACE=${USE_QEMU_TRACE:-true}
# When QEMU_LOG_DATETIME=true, use a date+time filename (expanded by shell)
# otherwise leave the default pattern which can contain %d (replaced by QEMU PID)
QEMU_LOG_DATETIME=${QEMU_LOG_DATETIME:-true}
TRACE_ARGS=""
if [ "${USE_QEMU_TRACE}" = "true" ]; then
    if [ "${QEMU_LOG_DATETIME}" = "true" ]; then
        LOGNAME="qemu_test-$(date +%Y%m%d-%H%M%S).log"
        TRACE_ARGS="-d trace:*vfio*,trace:*pci* -D ${LOGNAME} -msg timestamp=on"
    else
        TRACE_ARGS='-d trace:*vfio*,trace:*pci* -D qemu_test-%d.log -msg timestamp=on'
    fi
fi

# When requested, enable gdb stub (do not start CPU, wait for gdb)
GDB_ARGS=""
if [ "${kernel_gdb}" = "true" ]; then
    GDB_ARGS='-S -s'
fi


# Debug QEMU process itself via gdbserver prefix
QEMU_GDB_CMD=""
if [ "${qemu_gdb}" = "true" ]; then
    QEMU_GDB_CMD='gdb --args '
fi


# Configure guest memory size (512 MiB).
MEM_SIZE='-m 512M'

echo ${QEMU_GDB_CMD} @QEMU_CMD_LINE@ ${MEM_SIZE} ${EDU_DEV_ARG} ${IOMMU_ARGS} ${TRACE_ARGS} ${GDB_ARGS} ${PCIE_TOPO_ARGS} ${EXTRA_ARGS} "$@"
exec ${QEMU_GDB_CMD} @QEMU_CMD_LINE@  ${MEM_SIZE} ${EDU_DEV_ARG} ${IOMMU_ARGS} ${TRACE_ARGS} ${GDB_ARGS} ${PCIE_TOPO_ARGS} ${EXTRA_ARGS} "$@"
